    "integration_evidence": [
        "Snapshot sealed manifest and payload identities in durable restore intent before staging creation",
        "Reserve target name by endpoint and physical identity to reject aliases",
        "Synchronize and journal private tree identity before plaintext writes",
        "Hold opaque sealed-payload read lease and validate exact logical manifest and ciphertext while filling private output",
        "Use one active output file and a reusable64KiB comparison buffer; enforce entry/byte/depth/descriptor envelope",
        "Read back staged file bytes against authenticated payload and reject extra files using bounded native census",
        "Revalidate registered container and tree identities before exclusive native rename",
        "Synchronize both rename parents before persisting publication receipt",
        "Reconcile verified or already renamed effects through exact inode plus full contents and inventory verification",
        "Recover nested, empty and multi-record files after original source removal",
        "Reject existing file/directory/symlink targets, live owners, corrupted payloads, wrong keys, altered staging, moved containers, replaced inodes, cancellation and excess limits",
        "Migrate schema4 to5 and retain guarded transition/idempotency evidence"
    ],
